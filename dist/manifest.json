{
  "manifest_version": 3,
  "name": "Twitch AdBlock Local",
  "version": "0.3.72",
  "description": "Detecção local e mitigação conservadora de anúncios da Twitch.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "declarativeNetRequest"],
  "host_permissions": ["https://*.twitch.tv/*", "https://*.ttvnw.net/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_popup": "popup.html",
    "default_title": "Twitch AdBlock Local",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {"matches":["https://www.twitch.tv/*"],"js":["customPlayer.js", "content.js"],"run_at":"document_start"},
    {"matches":["https://www.twitch.tv/*"],"js":["pageHook.js"],"run_at":"document_start","world":"MAIN"}
  ]
}
